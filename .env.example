# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Primary LLM provider: gemini | openai | anthropic | ollama
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-3-flash-preview

# Embedding model (sentence-transformers model name)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# SQLite database path
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db

# ChromaDB path
CHROMA_DB_PATH=./data/embeddings

# FastAPI settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Agent settings
AGENT_NAME=Sentia
MAX_ITERATIONS=15
MAX_MEMORY_ITEMS=100
EXPERIENCE_REPLAY_BATCH=16

# Web search settings
MAX_SEARCH_RESULTS=5
REQUEST_TIMEOUT=30

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production

